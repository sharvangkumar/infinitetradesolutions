# ============================================================
# INFINITE TRADE SOLUTIONS — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ── ENQUIRY EMAIL (GoDaddy Titan mailbox via /api/enquiry) ───
# These are SERVER-SIDE only (no VITE_ prefix) — never exposed to the browser.
# Set these in the Vercel Project → Settings → Environment Variables, not just here.
# 1. This mailbox is on GoDaddy's Titan Email (see "Powered by Titan" in
#    webmail). Titan's SMTP is the same for every Titan mailbox:
#    - host smtp.titan.email, port 465 (SSL)
#    (Only use smtpout.secureserver.net / smtp.office365.com if you're on
#    older GoDaddy Workspace Email or Microsoft 365 via GoDaddy instead.)
# 2. SMTP_USER / SMTP_PASS are that mailbox's own login credentials
#    (full email address as username, its account password).
# 3. MAIL_TO is where enquiries land (defaults to sales@infinitetradesolutions.com).
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=sales@infinitetradesolutions.com
SMTP_PASS=your-mailbox-password
MAIL_TO=sales@infinitetradesolutions.com

# ── GOOGLE SHEETS WEBHOOK (Free, unlimited) ──────────────────
# 1. Open Google Sheets → Extensions → Apps Script
# 2. Paste the script from /docs/google-apps-script.js
# 3. Deploy → New deployment → Web App → Anyone can access
# 4. Copy the Web App URL below:
VITE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
